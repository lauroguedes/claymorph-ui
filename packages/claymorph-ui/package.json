{
  "name": "claymorph-ui",
  "version": "0.4.0",
  "description": "Claymorphism web components drawn by one WebGL2 shader, accessible by default with ui-sdk.",
  "keywords": [
    "web-components",
    "custom-elements",
    "claymorphism",
    "webgl2",
    "ui-sdk",
    "design-system"
  ],
  "license": "MIT",
  "author": "Lauro Guedes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lauroguedes/claymorph-ui.git",
    "directory": "packages/claymorph-ui"
  },
  "homepage": "https://claymorph-ui.lauroguedes.dev",
  "bugs": {
    "url": "https://github.com/lauroguedes/claymorph-ui/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./action-button": {
      "types": "./dist/entries/action-button.d.ts",
      "default": "./dist/entries/action-button.js"
    },
    "./avatar": {
      "types": "./dist/entries/avatar.d.ts",
      "default": "./dist/entries/avatar.js"
    },
    "./badge": {
      "types": "./dist/entries/badge.d.ts",
      "default": "./dist/entries/badge.js"
    },
    "./button": {
      "types": "./dist/entries/button.d.ts",
      "default": "./dist/entries/button.js"
    },
    "./button-group": {
      "types": "./dist/entries/button-group.d.ts",
      "default": "./dist/entries/button-group.js"
    },
    "./card": {
      "types": "./dist/entries/card.d.ts",
      "default": "./dist/entries/card.js"
    },
    "./checkbox": {
      "types": "./dist/entries/checkbox.d.ts",
      "default": "./dist/entries/checkbox.js"
    },
    "./dialog": {
      "types": "./dist/entries/dialog.d.ts",
      "default": "./dist/entries/dialog.js"
    },
    "./input": {
      "types": "./dist/entries/input.d.ts",
      "default": "./dist/entries/input.js"
    },
    "./menu": {
      "types": "./dist/entries/menu.d.ts",
      "default": "./dist/entries/menu.js"
    },
    "./meter": {
      "types": "./dist/entries/meter.d.ts",
      "default": "./dist/entries/meter.js"
    },
    "./popover": {
      "types": "./dist/entries/popover.d.ts",
      "default": "./dist/entries/popover.js"
    },
    "./progress": {
      "types": "./dist/entries/progress.d.ts",
      "default": "./dist/entries/progress.js"
    },
    "./radio": {
      "types": "./dist/entries/radio.d.ts",
      "default": "./dist/entries/radio.js"
    },
    "./segmented": {
      "types": "./dist/entries/segmented.d.ts",
      "default": "./dist/entries/segmented.js"
    },
    "./select": {
      "types": "./dist/entries/select.d.ts",
      "default": "./dist/entries/select.js"
    },
    "./slide-confirm": {
      "types": "./dist/entries/slide-confirm.d.ts",
      "default": "./dist/entries/slide-confirm.js"
    },
    "./slider": {
      "types": "./dist/entries/slider.d.ts",
      "default": "./dist/entries/slider.js"
    },
    "./switch": {
      "types": "./dist/entries/switch.d.ts",
      "default": "./dist/entries/switch.js"
    },
    "./tabs": {
      "types": "./dist/entries/tabs.d.ts",
      "default": "./dist/entries/tabs.js"
    },
    "./toast": {
      "types": "./dist/entries/toast.d.ts",
      "default": "./dist/entries/toast.js"
    },
    "./toggle": {
      "types": "./dist/entries/toggle.d.ts",
      "default": "./dist/entries/toggle.js"
    },
    "./tooltip": {
      "types": "./dist/entries/tooltip.d.ts",
      "default": "./dist/entries/tooltip.js"
    },
    "./clay.css": "./dist/clay.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/entries/*.js",
    "*.css"
  ],
  "peerDependencies": {
    "@ui-sdk/core": "^0.1.0-beta.17",
    "@ui-sdk/web": "^0.1.0-beta.17"
  }
}
