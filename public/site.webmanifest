{
  "name": "Claymorph UI",
  "short_name": "Claymorph",
  "description": "Claymorphism web components drawn by one WebGL2 shader, accessible by default with ui-sdk.",
  "start_url": "/",
  "display": "browser",
  "background_color": "#161b23",
  "theme_color": "#161b23",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
